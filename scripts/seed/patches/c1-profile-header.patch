+import type { Meta, StoryObj } from '@storybook/react-vite';
+import { Specimen, SpecimenStack } from '../../stories/StateGrid';
+import { Badge } from '../Badge';
+import { Button } from '../Button';
+import { ProfileHeader } from './ProfileHeader';
+
+const meta = {
+  title: 'Layout/ProfileHeader',
+  component: ProfileHeader,
+  args: { name: 'Dana Moreau', subtitle: 'Product designer, Payments' },
+  argTypes: { actions: { control: false }, meta: { control: false }, headingLevel: { control: 'inline-radio', options: [1, 2] } },
+} satisfies Meta<typeof ProfileHeader>;
+
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+export const Default: Story = {
+  args: {
+    meta: <Badge tone="success" dot>Available</Badge>,
+    actions: (
+      <>
+        <Button variant="secondary">Message</Button>
+        <Button>Edit profile</Button>
+      </>
+    ),
+  },
+};
+export const NameOnly: Story = { args: { subtitle: undefined } };
+
+export const AllStates: Story = {
+  render: () => (
+    <SpecimenStack>
+      <Specimen label="Name, subtitle, meta, actions">
+        <ProfileHeader name="Dana Moreau" subtitle="Product designer, Payments" meta={<Badge tone="success" dot>Available</Badge>} actions={<Button variant="secondary">Message</Button>} />
+      </Specimen>
+      <Specimen label="Name only">
+        <ProfileHeader name="Leo Martin" />
+      </Specimen>
+      <Specimen label="Long name, narrow container">
+        <div style={{ maxWidth: 320 }}>
+          <ProfileHeader name="Anne-Sophie Leroy-Delacourt" subtitle="Design lead" actions={<Button variant="secondary">Message</Button>} />
+        </div>
+      </Specimen>
+      <Specimen label="Heading level 2">
+        <ProfileHeader headingLevel={2} name="Ann Leroy" subtitle="Design lead" />
+      </Specimen>
+    </SpecimenStack>
+  ),
+};
diff --git a/packages/react/src/components/ProfileHeader/ProfileHeader.tsx b/packages/react/src/components/ProfileHeader/ProfileHeader.tsx
new file mode 100644
index 0000000..e7b4a18
--- /dev/null
+++ b/packages/react/src/components/ProfileHeader/ProfileHeader.tsx
@@ -0,0 +1,37 @@
+import { createElement, forwardRef, type HTMLAttributes, type ReactNode } from 'react';
+import { cx } from '../../utils/cx';
+import { Avatar } from '../Avatar';
+import styles from './ProfileHeader.module.css';
+
+export interface ProfileHeaderProps extends Omit<HTMLAttributes<HTMLElement>, 'title'> {
+  /** The person's full name, as they wrote it. Also names the avatar. */
+  name: string;
+  /** Role, team or one short line about the person: "Product designer, Payments". */
+  subtitle?: ReactNode;
+  /** Photo URL. Without it, the avatar shows initials. */
+  avatarSrc?: string;
+  /** Small facts under the subtitle: a Badge for status, location, local time. */
+  meta?: ReactNode;
+  /** One or two actions on this person: Message, Edit profile. */
+  actions?: ReactNode;
+  /** Heading level of the name. Default 1: the profile is the page. */
+  headingLevel?: 1 | 2;
+}
+
+/** The top of a profile page: the person's avatar, name, a subtitle, optional meta and actions. */
+export const ProfileHeader = forwardRef<HTMLElement, ProfileHeaderProps>(function ProfileHeader(
+  { name, subtitle, avatarSrc, meta, actions, headingLevel = 1, className, ...rest },
+  ref,
+) {
+  return (
+    <header ref={ref} className={cx(styles.profileHeader, className)} {...rest}>
+      <Avatar name={name} src={avatarSrc} size="lg" decorative className={styles.avatar} />
+      <div className={styles.text}>
+        {createElement(`h${headingLevel}`, { className: styles.name }, name)}
+        {subtitle != null && subtitle !== false && <p className={styles.subtitle}>{subtitle}</p>}
+        {meta != null && meta !== false && <div className={styles.meta}>{meta}</div>}
+      </div>
+      {actions != null && actions !== false && <div className={styles.actions}>{actions}</div>}
+    </header>
+  );
+});
