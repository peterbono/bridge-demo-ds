From 2736529fe43ec72386396f63b47be37ec1b06b1f Mon Sep 17 00:00:00 2001
From: peterbono <63565173+peterbono@users.noreply.github.com>
Date: Thu, 22 Oct 2026 00:40:01 +0200
Subject: [PATCH] feat(Card): subtle tone for secondary groups

---
 .changeset/card-subtle-tone.md                  |  5 +++++
 .../react/src/components/Card/Card.module.css   |  6 ++++++
 .../react/src/components/Card/Card.stories.tsx  | 17 +++++++++++++++--
 packages/react/src/components/Card/Card.tsx     | 10 ++++++++--
 4 files changed, 34 insertions(+), 4 deletions(-)
 create mode 100644 .changeset/card-subtle-tone.md

diff --git a/.changeset/card-subtle-tone.md b/.changeset/card-subtle-tone.md
new file mode 100644
index 0000000..f9bd6bd
--- /dev/null
+++ b/.changeset/card-subtle-tone.md
@@ -0,0 +1,5 @@
+---
+"@demo-ds/react": minor
+---
+
+Card: new `tone="subtle"`, a tinted plate without a border for secondary groups next to the main content.
diff --git a/packages/react/src/components/Card/Card.module.css b/packages/react/src/components/Card/Card.module.css
index ae0bec6..425e656 100644
--- a/packages/react/src/components/Card/Card.module.css
+++ b/packages/react/src/components/Card/Card.module.css
@@ -14,6 +14,12 @@
   overflow: hidden;
 }
 
+/* A tinted plate one step back from the page: the tint draws the edge, so the hairline goes. */
+.subtle {
+  border-color: transparent;
+  background-color: var(--color-bg-subtle);
+}
+
 .padding-compact {
   --_inset: var(--space-3);
 }
diff --git a/packages/react/src/components/Card/Card.stories.tsx b/packages/react/src/components/Card/Card.stories.tsx
index 68c6c75..4995982 100644
--- a/packages/react/src/components/Card/Card.stories.tsx
+++ b/packages/react/src/components/Card/Card.stories.tsx
@@ -7,8 +7,8 @@ import { Card, CardBody, CardFooter, CardHeader } from './Card';
 const meta = {
   title: 'Data display/Card',
   component: Card,
-  args: { padding: 'default', interactive: false },
-  argTypes: { padding: { control: 'inline-radio', options: ['none', 'compact', 'default'] } },
+  args: { padding: 'default', interactive: false, tone: 'default' },
+  argTypes: { padding: { control: 'inline-radio', options: ['none', 'compact', 'default'] }, tone: { control: 'inline-radio', options: ['default', 'subtle'] } },
 } satisfies Meta<typeof Card>;
 
 export default meta;
@@ -47,6 +47,19 @@ export const Interactive: Story = {
   ),
 };
 
+export const Subtle: Story = {
+  decorators: narrow,
+  args: { tone: 'subtle' },
+  render: (args) => (
+    <Card {...args} aria-labelledby="card-tips">
+      <CardHeader>
+        <span id="card-tips">Before you invite people</span>
+      </CardHeader>
+      <CardBody>Invited people see every project in this workspace. You can change their role at any time.</CardBody>
+    </Card>
+  ),
+};
+
 export const AllStates: Story = {
   render: () => (
     <SpecimenStack>
diff --git a/packages/react/src/components/Card/Card.tsx b/packages/react/src/components/Card/Card.tsx
index 1c6c4d1..0faf310 100644
--- a/packages/react/src/components/Card/Card.tsx
+++ b/packages/react/src/components/Card/Card.tsx
@@ -3,6 +3,7 @@ import { cx } from '../../utils/cx';
 import styles from './Card.module.css';
 
 export type CardPadding = 'none' | 'compact' | 'default';
+export type CardTone = 'default' | 'subtle';
 
 export interface CardProps extends HTMLAttributes<HTMLDivElement> {
   /**
@@ -13,14 +14,19 @@ export interface CardProps extends HTMLAttributes<HTMLDivElement> {
   interactive?: boolean;
   /** Inner spacing of header, body and footer. `none` for full-bleed tables and media. Default `default`. */
   padding?: CardPadding;
+  /**
+   * `subtle` sits one step back from the page: a tinted plate with no border, for secondary groups such as a
+   * summary beside a form or tips in an empty column. Default `default`.
+   */
+  tone?: CardTone;
 }
 
 /** A flat plate that groups related content. Pass aria-labelledby pointing at the header title when it is a landmark. */
 export const Card = forwardRef<HTMLDivElement, CardProps>(function Card(
-  { interactive = false, padding = 'default', className, ...rest },
+  { interactive = false, padding = 'default', tone = 'default', className, ...rest },
   ref,
 ) {
-  return <div ref={ref} className={cx(styles.card, styles[`padding-${padding}`], interactive && styles.interactive, className)} {...rest} />;
+  return <div ref={ref} className={cx(styles.card, styles[`padding-${padding}`], tone === 'subtle' && styles.subtle, interactive && styles.interactive, className)} {...rest} />;
 });
 
 export const CardHeader = forwardRef<HTMLDivElement, HTMLAttributes<HTMLDivElement>>(function CardHeader({ className, ...rest }, ref) {
